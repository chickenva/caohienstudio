# =========================================================
# LOCAL BACKEND - dung khi chay may ca nhan bang npm run dev
# =========================================================
PORT=5000
JWT_SECRET=your_jwt_secret_key_here
MONGO_URI=mongodb://localhost:27017/caohienstudio

# URL local dung de tao link hop dong, QR, email va VNPay return
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# =========================================================
# RENDER BACKEND - khai bao trong Environment cua Render
# Khong bo dau # trong file local, chi copy cac dong nay len Render
# =========================================================
# FRONTEND_URL=https://caohienstudio.onrender.com
# BACKEND_URL=https://caohienstudio-api.onrender.com

# =========================================================
# EMAIL
# =========================================================
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
CONTACT_RECEIVER_EMAIL=your_email@gmail.com

# =========================================================
# VNPAY PAYMENT GATEWAY
# Code uu tien doc nhom VNPAY_*, cac bien VNP_* giu lai de tuong thich.
# =========================================================
VNPAY_TMN_CODE=your_vnpay_tmncode
VNPAY_SECRET_KEY=your_vnpay_hashsecret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/vnpay-return

# Alias cu, giu lai de code cu/du phong van chay
VNP_TMNCODE=your_vnpay_tmncode
VNP_HASHSECRET=your_vnpay_hashsecret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURNURL=http://localhost:5173/vnpay-return

# Khi deploy backend len Render, khai bao cac bien VNPay URL nhu sau:
# VNPAY_RETURN_URL=https://caohienstudio.onrender.com/vnpay-return
# VNP_RETURNURL=https://caohienstudio.onrender.com/vnpay-return

# =========================================================
# GOOGLE DRIVE API (ALBUM MANAGEMENT)
# =========================================================
GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_folder_id

# =========================================================
# SUPER ADMIN ACCOUNT SEEDING
# =========================================================
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@123
ADMIN_FULL_NAME=Admin Cao Hien Studio
ADMIN_PHONE=0948997984

# =========================================================
# GOOGLE GEMINI AI CHATBOT
# =========================================================
GEMINI_API_KEY=your_gemini_api_key_here
