# ========================================
# SERVER CONFIGURATION
# ========================================
PORT=5000
NODE_ENV=development

# ========================================
# DATABASE
# ========================================
MONGO_URI=mongodb://localhost:27017/caohienstudio
# Hoặc sử dụng MongoDB Atlas
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/caohienstudio

# ========================================
# AUTHENTICATION
# ========================================
JWT_SECRET=your_super_secret_jwt_key_here_12345
JWT_EXPIRE=7d
BCRYPT_ROUNDS=10

# ========================================
# EMAIL (Nodemailer)
# ========================================
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_app_specific_password
# Lấy App Password tại: https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# ========================================
# VNPAY PAYMENT GATEWAY
# ========================================
# Lấy từ: https://sandbox.vnpayment.vn
VNPAY_TMN_CODE=TMNCODE
VNPAY_SECRET_KEY=secretkey123
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/vnpay-return

# Hoặc sử dụng tên khác (tương thích)
VNP_TMNCODE=TMNCODE
VNP_HASHSECRET=secretkey123

# ========================================
# PAYOS PAYMENT GATEWAY
# ========================================
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_WEBHOOK_SECRET=your_webhook_secret

# ========================================
# REDIS (Optional - Cache)
# ========================================
REDIS_URL=redis://:password@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ========================================
# FRONTEND URL
# ========================================
FRONTEND_URL=http://localhost:5173

# ========================================
# FILE UPLOAD
# ========================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=debug
