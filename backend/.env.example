# =========================================================
# LOCAL BACKEND - dung khi chay may ca nhan bang npm run dev
# =========================================================
PORT=5000
JWT_SECRET=your_jwt_secret_key_here
MONGO_URI=mongodb://localhost:27017/caohienstudio

# URL local dung de tao link hop dong, QR va email
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# =========================================================
# RENDER BACKEND - khai bao trong Environment cua Render
# Khong bo dau # trong file local, chi copy cac dong nay len Render
# =========================================================
# FRONTEND_URL=https://caohienstudio.onrender.com
# BACKEND_URL=https://caohienstudio-api.onrender.com

# =========================================================
# EMAIL
# =========================================================
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here
CONTACT_RECEIVER_EMAIL=your_email@gmail.com

# =========================================================
# THANH TOAN THU CONG (Cash / Chuyen khoan)
# Khong dung cong thanh toan VNPay.
# Thanh toan: tien mat tai studio HOAC chuyen khoan theo QR co dinh.
# =========================================================

# URL anh QR tai khoan ngan hang cua studio (upload len Cloudinary/Drive hoac dat trong public/)
# Dung de hien thi QR code thanh toan tren trang hop dong va email.
# Neu de trong thi trang hop dong se an phan QR code.
PAYMENT_QR_URL=https://your-domain.com/path/to/qr-code.png

# Thong tin tai khoan ngan hang hien thi cho khach (tuy chon, hien thi kem QR)
# PAYMENT_BANK_NAME=Vietcombank
# PAYMENT_ACCOUNT_NUMBER=1234567890
# PAYMENT_ACCOUNT_NAME=CAO HIEN STUDIO

# =========================================================
# GOOGLE DRIVE API (ALBUM MANAGEMENT)
# =========================================================
GOOGLE_APPLICATION_CREDENTIALS=./google-service-account.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_google_drive_folder_id

# =========================================================
# SUPER ADMIN ACCOUNT SEEDING
# =========================================================
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=Admin@123
ADMIN_FULL_NAME=Admin Cao Hien Studio
ADMIN_PHONE=0948997984

# =========================================================
# GOOGLE GEMINI AI CHATBOT
# =========================================================
GEMINI_API_KEY=your_gemini_api_key_here
